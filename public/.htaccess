# Zealous Solutions - Apache config for the static export.
# Upload alongside the rest of out/ into public_html.

ErrorDocument 404 /404.html

# No directory listings: folders such as /seq/ have no index page.
Options -Indexes

# trailingSlash:true means every route is a directory with an index.html,
# so Apache's default DirectoryIndex handles routing without rewrites.
DirectoryIndex index.html

# -- HTTPS and one canonical host -------------------------------------------
# Sends http:// and www. to https://zealoussolutions.us in a single redirect.
# Needs an SSL certificate on the domain first (cPanel > SSL/TLS Status, AutoSSL).
# The X-Forwarded-Proto check stops a redirect loop behind a proxy or CDN.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://zealoussolutions.us%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.zealoussolutions\.us$ [NC]
  RewriteRule ^ https://zealoussolutions.us%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build output and pre-sized media never change in place.
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # HTML must revalidate, or deploys won't be picked up.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # -- Security headers ------------------------------------------------------
  # "always" so they are sent on error pages and redirects too.

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nobody may frame the site (clickjacking). frame-ancestors in the CSP below
  # is the modern control; X-Frame-Options covers older browsers.
  Header always set X-Frame-Options "DENY"

  # The site uses none of these device features.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Browsers remember to use HTTPS only. Sent over HTTPS only, as the spec
  # requires. Subdomains are left out on purpose: cPanel ones such as webmail.
  # may not all have certificates.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  # Content Security Policy. Everything the site loads is on its own domain.
  # 'unsafe-inline' for scripts is required: Next's static export writes its
  # page data as inline <script> tags, and nonces need a server to generate.
  # Styles need it for inline style attributes. If you ever add analytics, a
  # chat widget or embedded video, add its domain here or it will be blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
